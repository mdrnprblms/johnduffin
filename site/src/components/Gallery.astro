---
import ArtworkCard from './ArtworkCard.astro'
import type {Artwork} from '../lib/sanity'

interface Props {
  artworks: Artwork[]
}

const {artworks} = Astro.props

const CATEGORIES: {label: string; value: Artwork['category']}[] = [
  {label: 'Oils', value: 'oils'},
  {label: 'Prints', value: 'prints'},
  {label: 'Pastels', value: 'pastels'},
  {label: 'Watercolours', value: 'watercolours'},
  {label: 'Drawings', value: 'drawings'},
]
const CATEGORY_LABEL = new Map(CATEGORIES.map((c) => [c.value, c.label]))
const CATEGORY_RANK = new Map(CATEGORIES.map((c, i) => [c.value, i]))

const presentCategories = new Set(artworks.map((a) => a.category))

// One section per year (newest first), each split into per-medium subsections.
// Undated pieces collect in a single trailing group.
interface CategoryGroup {
  category: Artwork['category']
  label: string
  artworks: Artwork[]
}
interface YearSection {
  id: string
  year: number | null
  label: string
  groups: CategoryGroup[]
  categories: Artwork['category'][]
  total: number
}

const sorted = [...artworks].sort((a, b) => {
  const ay = a.year ?? -Infinity
  const by = b.year ?? -Infinity
  if (ay !== by) return by - ay
  const ar = CATEGORY_RANK.get(a.category) ?? 99
  const br = CATEGORY_RANK.get(b.category) ?? 99
  if (ar !== br) return ar - br
  if ((a.seriesOrder ?? 0) !== (b.seriesOrder ?? 0)) return (a.seriesOrder ?? 0) - (b.seriesOrder ?? 0)
  return (a.order ?? 0) - (b.order ?? 0)
})

const byYear = new Map<number | null, Map<Artwork['category'], Artwork[]>>()
for (const artwork of sorted) {
  const year = artwork.year ?? null
  let categories = byYear.get(year)
  if (!categories) {
    categories = new Map()
    byYear.set(year, categories)
  }
  const list = categories.get(artwork.category)
  if (list) list.push(artwork)
  else categories.set(artwork.category, [artwork])
}

const sections: YearSection[] = []
for (const [year, categories] of byYear) {
  const groups: CategoryGroup[] = []
  for (const [category, list] of categories) {
    groups.push({category, label: CATEGORY_LABEL.get(category) ?? category, artworks: list})
  }
  sections.push({
    id: year === null ? 'undated' : `year-${year}`,
    year,
    label: year === null ? 'Undated' : String(year),
    groups,
    categories: groups.map((g) => g.category),
    total: groups.reduce((sum, g) => sum + g.artworks.length, 0),
  })
}

// Timeline spine: years bracketed by decade so a 30-year span stays scannable.
interface Decade {
  label: string
  sections: YearSection[]
}
const decades: Decade[] = []
for (const section of sections) {
  const label = section.year === null ? 'Undated' : `${Math.floor(section.year / 10) * 10}s`
  const last = decades[decades.length - 1]
  if (last && last.label === label) last.sections.push(section)
  else decades.push({label, sections: [section]})
}
---

<div class="gallery">
  <aside class="timeline" aria-label="Jump to a year">
    <nav>
      {
        decades.map((decade) => (
          <div class="decade" data-decade>
            {decade.label !== 'Undated' && <p class="decade-label">{decade.label}</p>}
            <ul>
              {decade.sections.map((section) => (
                <li data-categories={section.categories.join(' ')}>
                  <a href={`#${section.id}`}>{section.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </aside>

  <div class="content">
    <div class="filters">
      <div class="mediums" role="group" aria-label="Filter by medium">
        <button type="button" class="filter-btn" data-filter="all">All</button>
        {
          CATEGORIES.filter((c) => presentCategories.has(c.value)).map((c) => (
            <button type="button" class="filter-btn" data-filter={c.value}>
              {c.label}
            </button>
          ))
        }
      </div>
      <label class="switch">
        <input type="checkbox" data-for-sale />
        <span class="track" aria-hidden="true"></span>
        <span class="switch-label">For sale only</span>
      </label>
      <span class="count" data-count></span>
    </div>

    {
      sections.map((section) => (
        <section id={section.id} class="year-section" data-categories={section.categories.join(' ')}>
          <h2 class="year-heading">{section.label}</h2>
          {section.groups.map((group) => (
            <div class="medium-group" data-category={group.category}>
              <h3 class="medium-heading">{group.label}</h3>
              <div class="grid">
                {group.artworks.map((artwork) => (
                  <ArtworkCard artwork={artwork} />
                ))}
              </div>
            </div>
          ))}
        </section>
      ))
    }
    <p class="empty" hidden>No pieces match this filter.</p>
  </div>
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .timeline {
    position: sticky;
    top: 1.5rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .decade + .decade {
    margin-top: 1.1rem;
  }

  .decade-label {
    margin: 0 0 0.3rem;
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0.65;
  }

  .timeline ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .timeline a {
    display: block;
    padding: 0.28rem 0 0.28rem 0.75rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.82rem;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .timeline a:hover,
  .timeline li.active a {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  .content {
    min-width: 0;
  }

  .filters {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    background: var(--bg);
    padding: 1rem 0 0.9rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .mediums {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .switch {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
  }

  .switch input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .track {
    position: relative;
    flex: none;
    width: 34px;
    height: 19px;
    border-radius: 999px;
    background: #d8d5ce;
    transition: background 0.15s ease;
  }

  .track::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
    transition: transform 0.15s ease;
  }

  .switch input:checked + .track {
    background: var(--accent);
  }

  .switch input:checked + .track::after {
    transform: translateX(15px);
  }

  .switch input:focus-visible + .track {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .switch-label {
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .switch input:checked ~ .switch-label {
    color: var(--accent);
  }

  .filter-btn {
    font: inherit;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--muted);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .filter-btn.active {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .count {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .year-section {
    margin-bottom: 3.5rem;
    scroll-margin-top: 4.25rem;
  }

  .year-heading {
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
    margin: 0 0 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }

  .medium-group + .medium-group {
    margin-top: 2.25rem;
  }

  .medium-heading {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 2rem 1.5rem;
  }

  .empty {
    color: var(--muted);
    padding: 3rem 0;
    text-align: center;
  }

  @media (max-width: 800px) {
    .gallery {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .timeline {
      display: none;
    }
  }
</style>

<script>
  function initGallery(root: HTMLElement) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.filter-btn'))
    const sections = Array.from(root.querySelectorAll<HTMLElement>('.year-section'))
    const groups = Array.from(root.querySelectorAll<HTMLElement>('.medium-group'))
    const timelineItems = Array.from(root.querySelectorAll<HTMLElement>('.timeline li'))
    const decadeBlocks = Array.from(root.querySelectorAll<HTMLElement>('[data-decade]'))
    const countEl = root.querySelector<HTMLElement>('[data-count]')
    const emptyEl = root.querySelector<HTMLElement>('.empty')

    const forSaleInput = root.querySelector<HTMLInputElement>('[data-for-sale]')
    // Cards grouped by their owning medium-group, so filtering does not rescan
    // the whole 2,000-card DOM on every toggle.
    const groupCards = new Map<HTMLElement, HTMLElement[]>()
    for (const group of groups) {
      groupCards.set(group, Array.from(group.querySelectorAll<HTMLElement>('.card')))
    }
    const sectionGroups = new Map<HTMLElement, HTMLElement[]>()
    for (const section of sections) {
      sectionGroups.set(section, groups.filter((g) => g.closest('.year-section') === section))
    }

    let medium = 'all'
    let forSaleOnly = false

    function apply() {
      let visible = 0
      const visibleSections = new Set<string>()

      for (const section of sections) {
        let sectionCount = 0

        for (const group of sectionGroups.get(section) ?? []) {
          const mediumMatch = medium === 'all' || group.dataset.category === medium
          let groupCount = 0

          if (mediumMatch) {
            for (const card of groupCards.get(group) ?? []) {
              const show = !forSaleOnly || card.dataset.status === 'available'
              card.hidden = !show
              if (show) groupCount++
            }
          }
          group.hidden = !mediumMatch || groupCount === 0
          sectionCount += groupCount
        }

        section.hidden = sectionCount === 0
        if (sectionCount > 0) visibleSections.add(section.id)
        visible += sectionCount
      }

      for (const item of timelineItems) {
        const href = item.querySelector('a')?.getAttribute('href') ?? ''
        item.hidden = !visibleSections.has(href.slice(1))
      }
      // Hide a decade heading once every year under it is filtered out.
      for (const block of decadeBlocks) {
        const anyVisible = Array.from(block.querySelectorAll<HTMLElement>('li')).some((li) => !li.hidden)
        block.hidden = !anyVisible
      }

      if (countEl) countEl.textContent = `${visible.toLocaleString()} piece${visible === 1 ? '' : 's'}`
      if (emptyEl) emptyEl.hidden = visible !== 0
      for (const btn of buttons) {
        btn.classList.toggle('active', btn.dataset.filter === medium)
      }
      syncUrl()
    }

    // Mirror the state in the URL so a "for sale" view stays linkable now that
    // it no longer has a page of its own.
    function syncUrl() {
      const url = new URL(window.location.href)
      if (forSaleOnly) url.searchParams.set('for-sale', '1')
      else url.searchParams.delete('for-sale')
      if (medium !== 'all') url.searchParams.set('medium', medium)
      else url.searchParams.delete('medium')
      window.history.replaceState(null, '', url.toString())
    }

    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        medium = btn.dataset.filter || 'all'
        apply()
      })
    }

    forSaleInput?.addEventListener('change', () => {
      forSaleOnly = forSaleInput.checked
      apply()
    })

    const params = new URLSearchParams(window.location.search)
    if (params.get('for-sale') === '1') {
      forSaleOnly = true
      if (forSaleInput) forSaleInput.checked = true
    }
    const startMedium = params.get('medium')
    if (startMedium && buttons.some((b) => b.dataset.filter === startMedium)) medium = startMedium

    // Highlight the year currently in view.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          const id = entry.target.id
          for (const item of timelineItems) {
            const link = item.querySelector('a')
            item.classList.toggle('active', link?.getAttribute('href') === `#${id}`)
          }
        }
      },
      {rootMargin: '-20% 0px -70% 0px'},
    )
    for (const section of sections) observer.observe(section)

    apply()
  }

  document.querySelectorAll<HTMLElement>('.gallery').forEach(initGallery)
</script>
