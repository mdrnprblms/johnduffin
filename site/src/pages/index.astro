---
import Layout from '../layouts/Layout.astro'
import {withBase} from '../lib/paths'

// `c_limit` caps at the source, so this returns the artwork at its native
// 1240x1890 — it's a portrait scan, hence the tall hero.
const HERO_IMAGE_URL =
  'https://static-assets.artlogic.net/w_2400,c_limit,f_auto,fl_lossy,q_auto/artlogicstorage/bg/images/view/0403b41a4d3dafe2b2bf17dc1df29f10/banksidegallery-john-duffin-rws-re-thames-bridges-east-sunrise.jpg'
---

<Layout title="Home" fullBleed>
  <div class="hero">
    <img
      class="hero-image"
      src={HERO_IMAGE_URL}
      width="1240"
      height="1890"
      alt="Thames Bridges East, Sunrise — watercolour by John Duffin"
    />
    <div class="links">
      <a class="button" href={withBase('/portfolio')}>WORK</a>
    </div>
  </div>
</Layout>

<style>
  .hero {
    position: relative;
  }

  /* Full screen width, natural height — the whole painting stays visible,
     even though that pushes it past the fold. */
  .hero-image {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Pinned to the viewport, not the page: the hero is taller than the screen,
     so anything in flow would scroll away as you move down the painting. */
  .links {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* svh, not vh/dvh: a constant height means the button holds its spot on
       screen even as a phone's address bar collapses and expands. */
    height: 100vh;
    height: 100svh;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    /* Only the button itself should swallow taps. */
    pointer-events: none;
  }

  .links > * {
    pointer-events: auto;
  }

  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
    border-radius: 2px;
    letter-spacing: var(--tracking);
    font-size: 0.9rem;
  }
</style>
