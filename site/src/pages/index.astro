---
import Layout from '../layouts/Layout.astro'
import {withBase} from '../lib/paths'

const HERO_IMAGE_URL =
  'https://static-assets.artlogic.net/w_1200,c_limit,f_auto,fl_lossy,q_auto/artlogicstorage/bg/images/view/0403b41a4d3dafe2b2bf17dc1df29f10/banksidegallery-john-duffin-rws-re-thames-bridges-east-sunrise.jpg'
---

<Layout title="Home" fullBleed>
  <div class="hero-image" style={`background-image: url(${HERO_IMAGE_URL})`}></div>
  <section class="hero">
    <div class="links">
      <a class="button" href={withBase('/portfolio')}>View the work</a>
    </div>
  </section>
</Layout>

<style>
  .hero-image {
    flex: 1;
    min-height: 60vh;
    background-size: cover;
    background-position: center;
  }

  .hero {
    text-align: center;
    padding: 2rem;
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
    border-radius: 2px;
    letter-spacing: var(--tracking);
    font-size: 0.9rem;
  }
</style>
