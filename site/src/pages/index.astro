---
import Layout from '../layouts/Layout.astro'
import HeroCarousel from '../components/HeroCarousel.astro'
import {withBase} from '../lib/paths'
import {getAllArtworks, type Artwork} from '../lib/sanity'

const artworks = await getAllArtworks()
const withImages = artworks.filter((a) => a.image)

// Deterministic-per-build shuffle so the homepage doesn't always open on
// the same handful of pieces.
function shuffle(list: Artwork[]): Artwork[] {
  const copy = [...list]
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1))
    ;[copy[i], copy[j]] = [copy[j], copy[i]]
  }
  return copy
}

const featured = shuffle(withImages).slice(0, 10)
---

<Layout title="Home">
  <section class="hero">
    <h1>John Duffin</h1>
    <p>Paintings, prints, pastels, watercolours and drawings.</p>
    <div class="links">
      <a class="button" href={withBase('/portfolio')}>View the work</a>
    </div>
  </section>

  <HeroCarousel artworks={featured} />
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 0 0;
  }

  .hero h1 {
    font-size: 2.4rem;
    margin-bottom: 0.5rem;
  }

  .hero p {
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
    border-radius: 2px;
    letter-spacing: var(--tracking);
    font-size: 0.9rem;
  }
</style>
